{
  "name": "english-partner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Study talks as craft \u2014 dual-layer transcripts, sourced word cards, and a Markdown vault as the source of truth.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
